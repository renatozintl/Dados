LEFT JOIN R073FOT FOTO ON ALUNO.NUMMAT = FOTO.NUMMAT
WHERE NOT EXISTS (
    SELECT 1 FROM R073HSA HST_SITUACAO
    INNER JOIN R073STA SITUACAO ON HST_SITUACAO.CODSTA = SITUACAO.CODSTA AND SITUACAO.BLOACE = 'S'
    WHERE HST_SITUACAO.NUMMAT = ALUNO.NUMMAT
      AND (HST_SITUACAO.DATINI < TRUNC(SYSDATE)
           OR (HST_SITUACAO.DATINI = TRUNC(SYSDATE) AND HST_SITUACAO.HORINI <= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
      AND (HST_SITUACAO.DATFIM IS NULL OR HST_SITUACAO.DATFIM = TO_DATE('1900-12-31', 'YYYY-MM-DD')
           OR HST_SITUACAO.DATFIM > TRUNC(SYSDATE)
           OR (HST_SITUACAO.DATFIM = TRUNC(SYSDATE) AND HST_SITUACAO.HORFIM >= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
)
UNION ALL
SELECT
    CAST(COALESCE(CRACHA_PROVISORIO.NUMCRA, CRACHA_TITULAR.NUMCRA) AS varchar(12)) AS matricula,
    OUTRAS_UNIDADES.NOMCRA AS nome,
    NULL AS email_com, NULL AS email_pes,
    NULL AS telefone_cel, NULL AS telefone_com, NULL AS telefone_fix, NULL AS telefone_ficha,
    OUTRAS_UNIDADES.FOTOCR AS foto,
    TO_CHAR(OUTRAS_UNIDADES.DATFOT + OUTRAS_UNIDADES.HORFOT / 1440, 'YYYY-MM-DD HH24:MI:SS') AS datahora,
    ('O:' || OUTRAS_UNIDADES.NUMEMP || ':' || OUTRAS_UNIDADES.NUMCAD) AS write_key,
    'R070OCR' AS verify_alvo,
    CAST(COALESCE(CRACHA_PROVISORIO.NUMCRA, CRACHA_TITULAR.NUMCRA) AS varchar(12)) AS verify_numcra,
    OUTRAS_UNIDADES.NUMEMP AS verify_numemp, NULL AS verify_tipcol,
    OUTRAS_UNIDADES.NUMCAD AS verify_numcad, NULL AS verify_nummat,
    NULL AS cpf,
    'outras_unidades' AS tipo,
    NVL(TRIM(OUTRAS_UNIDADES.USARFA), 'S') AS usa_facial
FROM R070OCR OUTRAS_UNIDADES
INNER JOIN R070HCH CRACHA_TITULAR
    ON OUTRAS_UNIDADES.NUMEMP = CRACHA_TITULAR.NUMEMP AND OUTRAS_UNIDADES.NUMCAD = CRACHA_TITULAR.NUMCAD
   AND CRACHA_TITULAR.TIPCRA = 1
   AND (CRACHA_TITULAR.DATINI < TRUNC(SYSDATE)
        OR (CRACHA_TITULAR.DATINI = TRUNC(SYSDATE) AND CRACHA_TITULAR.HORINI <= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
   AND (CRACHA_TITULAR.DATFIM IS NULL OR CRACHA_TITULAR.DATFIM = TO_DATE('1900-12-31', 'YYYY-MM-DD')
        OR CRACHA_TITULAR.DATFIM > TRUNC(SYSDATE)
        OR (CRACHA_TITULAR.DATFIM = TRUNC(SYSDATE) AND CRACHA_TITULAR.HORFIM >= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
LEFT JOIN R070HCH CRACHA_PROVISORIO
    ON OUTRAS_UNIDADES.NUMEMP = CRACHA_PROVISORIO.NUMEMP AND OUTRAS_UNIDADES.NUMCAD = CRACHA_PROVISORIO.NUMCAD
   AND CRACHA_PROVISORIO.TIPCRA = 2
   AND (CRACHA_PROVISORIO.DATINI < TRUNC(SYSDATE)
        OR (CRACHA_PROVISORIO.DATINI = TRUNC(SYSDATE) AND CRACHA_PROVISORIO.HORINI <= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
   AND (CRACHA_PROVISORIO.DATFIM IS NULL OR CRACHA_PROVISORIO.DATFIM = TO_DATE('1900-12-31', 'YYYY-MM-DD')
        OR CRACHA_PROVISORIO.DATFIM > TRUNC(SYSDATE)
        OR (CRACHA_PROVISORIO.DATFIM = TRUNC(SYSDATE) AND CRACHA_PROVISORIO.HORFIM >= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
```

## Consulta 2 — visitantes

Só traz quem está presente **agora**, com entrada aberta. Fora do horário de visita ela pode voltar vazia, e isso
não é erro.

```sql
SELECT
    CAST(HCH.NUMCRA AS varchar(12)) AS matricula,
    VIS.NOMVIS AS nome,
    VIS.FOTVIS AS foto,
    CAST(VIS.TIPDOC AS varchar(20)) || '|' || CAST(VIS.NUMDOC AS varchar(40)) AS write_key,
    VIS.TIPDOC AS verify_tipdoc, VIS.NUMDOC AS verify_numdoc,
    CAST(HCH.NUMCRA AS varchar(12)) AS verify_numcra,
    'R090VIS' AS verify_alvo
FROM R090VIS VIS
INNER JOIN R090HCH HCH
    ON HCH.TIPDOC = VIS.TIPDOC AND HCH.NUMDOC = VIS.NUMDOC
   AND (HCH.DATINI < TRUNC(SYSDATE) OR (HCH.DATINI = TRUNC(SYSDATE) AND HCH.HORINI <= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
   AND (HCH.DATFIM = TO_DATE('1900-12-31', 'YYYY-MM-DD') OR HCH.DATFIM IS NULL OR HCH.DATFIM > TRUNC(SYSDATE)
        OR (HCH.DATFIM = TRUNC(SYSDATE) AND HCH.HORFIM >= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
WHERE EXISTS (
      SELECT 1 FROM R090MVI MVI
      INNER JOIN R090TVI TVI ON TVI.TIPVIS = MVI.TIPVIS AND NVL(TRIM(TVI.USARFA), 'S') = 'S'
      WHERE MVI.TIPDOC = VIS.TIPDOC AND MVI.NUMDOC = VIS.NUMDOC
        AND (MVI.DATENT < TRUNC(SYSDATE) OR (MVI.DATENT = TRUNC(SYSDATE) AND MVI.HORENT <= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
        AND (MVI.DATSAI = TO_DATE('1900-12-31', 'YYYY-MM-DD') OR MVI.DATSAI IS NULL OR MVI.DATSAI > TRUNC(SYSDATE)
             OR (MVI.DATSAI = TRUNC(SYSDATE) AND MVI.HORSAI >= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
  )
```

## Como colocar no Visage

1. Configuração → **Fonte** → **✎ Criar/editar query**. O campo vem com a consulta atual, a do preset.
2. Apague o conteúdo, cole a **Consulta 1** e clique em **Salvar query personalizada**. O preset continua como
   base.
3. Se a fonte de visitantes estiver ligada: **✎ Criar/editar query de visitantes**, cole a **Consulta 2** e salve.
4. **Para desfazer:** **Voltar ao preset**. A regra volta a ser só o `'S'` traz o rosto.

**O que acontece depois de salvar:**
- **Na próxima leitura completa:** quem era nulo ou em branco passa a ter a foto lida, vai à conferência do Cloud
  e depois aos FC1000 com rosto. Se forem milhares, leva um tempo, como uma carga inicial.
- **Atualizações do Visage não chegam a esta consulta:** ela fica fixa nesta instalação. Uma melhoria futura no
  preset só entra depois de **Voltar ao preset**.

