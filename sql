SELECT
    CAST(COALESCE(CRACHA_PROVISORIO.NUMCRA, CRACHA_TITULAR.NUMCRA) AS varchar(12)) AS matricula,
    COLABORADOR.NOMFUN AS nome,
    FICHA_COMPLEMENTAR.EMACOM AS email_com,
    FICHA_COMPLEMENTAR.EMAPAR AS email_pes,
    CASE WHEN TRIM(PESSOA_FISICA.NUMCEL) IS NOT NULL
         THEN CONCAT(NULLIF(PESSOA_FISICA.DDDCEL, 0), LTRIM(RTRIM(PESSOA_FISICA.NUMCEL))) END AS telefone_cel,
    TRIM(PESSOA_FISICA.TELCOM) AS telefone_com,
    CASE WHEN TRIM(PESSOA_FISICA.NUMTEL) IS NOT NULL
         THEN CONCAT(NULLIF(PESSOA_FISICA.DDDTEL, 0), LTRIM(RTRIM(PESSOA_FISICA.NUMTEL))) END AS telefone_fix,
    CASE WHEN TRIM(FICHA_COMPLEMENTAR.NUMTEL) IS NOT NULL AND COALESCE(FICHA_COMPLEMENTAR.DDITEL, 55) IN (0, 55)
         THEN CONCAT(NULLIF(FICHA_COMPLEMENTAR.DDDTEL, 0), LTRIM(RTRIM(FICHA_COMPLEMENTAR.NUMTEL))) END AS telefone_ficha,
    FOTO.FOTEMP AS foto,
    TO_CHAR(FOTO.DATFOT + FOTO.HORFOT / 1440, 'YYYY-MM-DD HH24:MI:SS') AS datahora,
    ('C:' || COLABORADOR.NUMEMP || ':' || COLABORADOR.TIPCOL || ':' || COLABORADOR.NUMCAD) AS write_key,
    'R034FOT' AS verify_alvo,
    CAST(COALESCE(CRACHA_PROVISORIO.NUMCRA, CRACHA_TITULAR.NUMCRA) AS varchar(12)) AS verify_numcra,
    COLABORADOR.NUMEMP AS verify_numemp,
    COLABORADOR.TIPCOL AS verify_tipcol,
    COLABORADOR.NUMCAD AS verify_numcad,
    NULL AS verify_nummat,
    COLABORADOR.NUMCPF AS cpf,
    CASE COLABORADOR.TIPCOL WHEN 1 THEN 'colaborador' WHEN 2 THEN 'terceiro'
                            WHEN 3 THEN 'parceiro' ELSE 'desconhecido' END AS tipo,
    NVL((SELECT MAX(NVL(TRIM(DEFINICOES_ACESSO.USARFA), 'S')) FROM R034DAC DEFINICOES_ACESSO
      WHERE DEFINICOES_ACESSO.NUMEMP = COLABORADOR.NUMEMP AND DEFINICOES_ACESSO.TIPCOL = COLABORADOR.TIPCOL
        AND DEFINICOES_ACESSO.NUMCAD = COLABORADOR.NUMCAD), 'S') AS usa_facial
FROM R034FUN COLABORADOR
INNER JOIN R038HCH CRACHA_TITULAR
    ON COLABORADOR.NUMEMP = CRACHA_TITULAR.NUMEMP
   AND COLABORADOR.TIPCOL = CRACHA_TITULAR.TIPCOL
   AND COLABORADOR.NUMCAD = CRACHA_TITULAR.NUMCAD
   AND CRACHA_TITULAR.TIPCRA = 1
   AND (CRACHA_TITULAR.DATINI < TRUNC(SYSDATE)
        OR (CRACHA_TITULAR.DATINI = TRUNC(SYSDATE) AND CRACHA_TITULAR.HORINI <= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
   AND (CRACHA_TITULAR.DATFIM IS NULL OR CRACHA_TITULAR.DATFIM = TO_DATE('1900-12-31', 'YYYY-MM-DD')
        OR CRACHA_TITULAR.DATFIM > TRUNC(SYSDATE)
        OR (CRACHA_TITULAR.DATFIM = TRUNC(SYSDATE) AND CRACHA_TITULAR.HORFIM >= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
LEFT JOIN R038HCH CRACHA_PROVISORIO
    ON COLABORADOR.NUMEMP = CRACHA_PROVISORIO.NUMEMP
   AND COLABORADOR.TIPCOL = CRACHA_PROVISORIO.TIPCOL
   AND COLABORADOR.NUMCAD = CRACHA_PROVISORIO.NUMCAD
   AND CRACHA_PROVISORIO.TIPCRA = 2
   AND (CRACHA_PROVISORIO.DATINI < TRUNC(SYSDATE)
        OR (CRACHA_PROVISORIO.DATINI = TRUNC(SYSDATE) AND CRACHA_PROVISORIO.HORINI <= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
   AND (CRACHA_PROVISORIO.DATFIM IS NULL OR CRACHA_PROVISORIO.DATFIM = TO_DATE('1900-12-31', 'YYYY-MM-DD')
        OR CRACHA_PROVISORIO.DATFIM > TRUNC(SYSDATE)
        OR (CRACHA_PROVISORIO.DATFIM = TRUNC(SYSDATE) AND CRACHA_PROVISORIO.HORFIM >= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
LEFT JOIN R034FOT FOTO
    ON COLABORADOR.NUMEMP = FOTO.NUMEMP AND COLABORADOR.TIPCOL = FOTO.TIPCOL
   AND COLABORADOR.NUMCAD = FOTO.NUMCAD
LEFT JOIN R034CPL FICHA_COMPLEMENTAR
    ON COLABORADOR.NUMEMP = FICHA_COMPLEMENTAR.NUMEMP AND COLABORADOR.TIPCOL = FICHA_COMPLEMENTAR.TIPCOL
   AND COLABORADOR.NUMCAD = FICHA_COMPLEMENTAR.NUMCAD
LEFT JOIN R033PES PESSOA_FISICA
    ON PESSOA_FISICA.CODPES = COLABORADOR.CODPES
   AND COLABORADOR.CODPES > 0
WHERE NOT EXISTS (
    SELECT 1 FROM R038AFA AFASTAMENTOS
    INNER JOIN R010SIT SITUACOES ON AFASTAMENTOS.SITAFA = SITUACOES.CODSIT AND SITUACOES.TIPSIT = 7
    WHERE AFASTAMENTOS.NUMEMP = COLABORADOR.NUMEMP AND AFASTAMENTOS.TIPCOL = COLABORADOR.TIPCOL
      AND AFASTAMENTOS.NUMCAD = COLABORADOR.NUMCAD AND AFASTAMENTOS.DATAFA <= TRUNC(SYSDATE)
)
UNION ALL
SELECT
    CAST(COALESCE(CRACHA_PROVISORIO.NUMCRA, CRACHA_TITULAR.NUMCRA) AS varchar(12)) AS matricula,
    ALUNO.NOMALU AS nome,
    ALUNO.EMAALU AS email_com,
    NULL AS email_pes,
    NULL AS telefone_cel, NULL AS telefone_com, NULL AS telefone_fix, NULL AS telefone_ficha,
    FOTO.FOTALU AS foto,
    TO_CHAR(FOTO.DATFOT + FOTO.HORFOT / 1440, 'YYYY-MM-DD HH24:MI:SS') AS datahora,
    CONCAT('A:', ALUNO.NUMMAT) AS write_key,
    'R073FOT' AS verify_alvo,
    CAST(COALESCE(CRACHA_PROVISORIO.NUMCRA, CRACHA_TITULAR.NUMCRA) AS varchar(12)) AS verify_numcra,
    NULL AS verify_numemp, NULL AS verify_tipcol, NULL AS verify_numcad,
    ALUNO.NUMMAT AS verify_nummat,
    NULL AS cpf,
    'aluno' AS tipo,
    NVL(TRIM(ALUNO.USARFA), 'S') AS usa_facial
FROM R073ALU ALUNO
INNER JOIN R073HCH CRACHA_TITULAR
    ON ALUNO.NUMMAT = CRACHA_TITULAR.NUMMAT AND CRACHA_TITULAR.TIPCRA = 1
   AND (CRACHA_TITULAR.DATINI < TRUNC(SYSDATE)
        OR (CRACHA_TITULAR.DATINI = TRUNC(SYSDATE) AND CRACHA_TITULAR.HORINI <= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
   AND (CRACHA_TITULAR.DATFIM IS NULL OR CRACHA_TITULAR.DATFIM = TO_DATE('1900-12-31', 'YYYY-MM-DD')
        OR CRACHA_TITULAR.DATFIM > TRUNC(SYSDATE)
        OR (CRACHA_TITULAR.DATFIM = TRUNC(SYSDATE) AND CRACHA_TITULAR.HORFIM >= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
LEFT JOIN R073HCH CRACHA_PROVISORIO
    ON ALUNO.NUMMAT = CRACHA_PROVISORIO.NUMMAT AND CRACHA_PROVISORIO.TIPCRA = 2
   AND (CRACHA_PROVISORIO.DATINI < TRUNC(SYSDATE)
        OR (CRACHA_PROVISORIO.DATINI = TRUNC(SYSDATE) AND CRACHA_PROVISORIO.HORINI <= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
   AND (CRACHA_PROVISORIO.DATFIM IS NULL OR CRACHA_PROVISORIO.DATFIM = TO_DATE('1900-12-31', 'YYYY-MM-DD')
        OR CRACHA_PROVISORIO.DATFIM > TRUNC(SYSDATE)
        OR (CRACHA_PROVISORIO.DATFIM = TRUNC(SYSDATE) AND CRACHA_PROVISORIO.HORFIM >= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
LEFT JOIN R073FOT FOTO ON ALUNO.NUMMAT = FOTO.NUMMAT
WHERE NOT EXISTS (
    SELECT 1 FROM R073HSA HST_SITUACAO
    INNER JOIN R073STA SITUACAO ON HST_SITUACAO.CODSTA = SITUACAO.CODSTA AND SITUACAO.BLOACE = 'S'
    WHERE HST_SITUACAO.NUMMAT = ALUNO.NUMMAT
      AND (HST_SITUACAO.DATINI < TRUNC(SYSDATE)
           OR (HST_SITUACAO.DATINI = TRUNC(SYSDATE) AND HST_SITUACAO.HORINI <= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
      AND (HST_SITUACAO.DATFIM IS NULL OR HST_SITUACAO.DATFIM = TO_DATE('1900-12-31', 'YYYY-MM-DD')
           OR HST_SITUACAO.DATFIM > TRUNC(SYSDATE)
           OR (HST_SITUACAO.DATFIM = TRUNC(SYSDATE) AND HST_SITUACAO.HORFIM >= (TO_NUMBER(TO_CHAR(SYSDATE, 'HH24')) * 60 + TO_NUMBER(TO_CHAR(SYSDATE, 'MI')))))
)
UNION ALL
